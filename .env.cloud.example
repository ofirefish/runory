# Copy this file to `.env.cloud` only on the deployment workstation.
# Never prefix deployment secrets with VITE_.
SUPABASE_ACCESS_TOKEN=your-personal-access-token
SUPABASE_PROJECT_REF=abcdefghijklmnopqrst
RUNORY_SMTP_HOST=smtp.example.com
RUNORY_SMTP_PORT=587
RUNORY_SMTP_USER=your-smtp-user
RUNORY_SMTP_PASS=your-smtp-password
RUNORY_SMTP_ADMIN_EMAIL=no-reply@auth.example.com
RUNORY_SMTP_SENDER_NAME=Runory
RUNORY_POLICY_ACTIVE_SIGNING_KEY_ID=policy-example
RUNORY_POLICY_SIGNING_KEYS_JSON={"policy-example":"base64-encoded-ed25519-pkcs8-private-key"}
