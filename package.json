{
  "name": "runory",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run src",
    "typecheck": "tsc -b --pretty false",
    "web:dev": "pnpm --dir apps/web dev",
    "web:build": "pnpm --dir apps/web build",
    "web:lint": "pnpm --dir apps/web lint",
    "web:typecheck": "pnpm --dir apps/web typecheck",
    "cloud:auth:check": "node scripts/supabase-auth-config.mjs --check",
    "cloud:auth:apply": "node --env-file=.env.cloud scripts/supabase-auth-config.mjs --apply",
    "cloud:auth:verify": "node --env-file=.env.cloud scripts/supabase-auth-config.mjs --verify",
    "cloud:db:test": "supabase test db",
    "cloud:db:lint": "supabase db lint --local --level warning --fail-on error",
    "cloud:db:advise": "supabase db advisors --local --type all --level warn --fail-on warn",
    "cloud:db:verify": "pnpm cloud:db:test && pnpm cloud:db:lint && pnpm cloud:db:advise",
    "cloud:functions:typecheck": "tsc -p supabase/functions/tsconfig.json --pretty false",
    "cloud:policy:e2e": "node scripts/test-policy-edge-e2e.mjs",
    "cloud:policy:keygen": "node scripts/generate-policy-signing-key.mjs",
    "cloud:remote:check": "node scripts/supabase-remote-readiness.mjs --check",
    "cloud:remote:check:json": "node scripts/supabase-remote-readiness.mjs --check --json",
    "cloud:remote:test": "node --test scripts/supabase-remote-readiness.test.mjs",
    "cloud:remote:verify": "node --env-file=.env.cloud scripts/supabase-remote-readiness.mjs --remote",
    "cloud:remote:verify:json": "node --env-file=.env.cloud scripts/supabase-remote-readiness.mjs --remote --json",
    "cloud:promotion:test": "node --test scripts/supabase-release-promotion.test.mjs",
    "cloud:promotion:prepare": "node scripts/supabase-release-promotion.mjs --prepare",
    "cloud:promotion:finalize": "node scripts/supabase-release-promotion.mjs --finalize",
    "cloud:promotion:verify": "node scripts/supabase-release-promotion.mjs --finalize",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@hookform/resolvers": "^5.2.1",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-tabs": "1.1.13",
    "@supabase/supabase-js": "2.112.4",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-biometric": "2.3.2",
    "@tauri-apps/plugin-deep-link": "2.4.10",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-opener": "2.5.5",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-webgl": "0.18.0",
    "@xterm/xterm": "^5.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.1.1",
    "i18next": "^25.5.2",
    "lucide-react": "^0.542.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.62.0",
    "react-i18next": "^15.7.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@tauri-apps/cli": "^2.8.4",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.34.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "jsdom": "26.1.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.41.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.5.0"
}
