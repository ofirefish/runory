{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Runory",
  "version": "0.1.0",
  "identifier": "com.runory.app",
  "build": { "beforeDevCommand": "pnpm dev", "devUrl": "http://localhost:1420", "beforeBuildCommand": "pnpm build", "frontendDist": "../dist" },
  "app": {
    "windows": [{ "title": "Runory", "width": 1440, "height": 900, "minWidth": 1024, "minHeight": 680, "decorations": false, "shadow": true }],
    "security": { "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src ipc: http://ipc.localhost https://*.supabase.co" }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["runory"] },
      "mobile": [{ "scheme": ["runory"], "appLink": false }]
    }
  }
}
