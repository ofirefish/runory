{
  "schemaVersion": 1,
  "id": "runory.hello",
  "name": "Runory Hello",
  "version": "1.0.0",
  "description": "Minimal Runory plugin",
  "publisher": {
    "id": "runory",
    "name": "Runory"
  },
  "apiVersion": "1",
  "minRunoryVersion": "0.1.0",
  "permissions": [
    "host.read",
    "ssh.exec"
  ],
  "contributes": {
    "commands": [
      {
        "id": "hello.inspect",
        "title": "Inspect Host",
        "category": "Runory Hello"
      }
    ],
    "hostMenus": [
      {
        "command": "hello.inspect",
        "group": "runory",
        "when": "host.os == 'linux'"
      }
    ],
    "workflows": [
      {
        "id": "hello.inspect",
        "file": "workflows/hello.yaml"
      }
    ]
  }
}
